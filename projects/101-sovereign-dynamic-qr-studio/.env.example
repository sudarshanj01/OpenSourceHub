# =========================================================================
# QRShield — Environment Configuration
# =========================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=qrshielddb
DATABASE_URL="postgresql://postgres:postgres@db:5432/qrshielddb?schema=public"

# App Port Configuration
PORT=3101
NODE_ENV=production

# Production Domain & SSL (Uncomment when deploying Caddy in production)
# DOMAIN=qr.yourbusiness.com
# ACME_EMAIL=admin@yourbusiness.com
