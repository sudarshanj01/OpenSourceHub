# OpenSheets - Application Configuration
PORT=3042
NODE_ENV=production

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=opensheets

# JWT & Authentication (7-Day Persistent Sessions)
JWT_SECRET=opensheets-jwt-super-secret-production-2026

# Initial Administrator Credentials (Configurable via UI or .env)
ADMIN_EMAIL=admin@opensheets.internal
ADMIN_PASSWORD=Admin@123456

# Company Organization Settings
COMPANY_NAME=Apex Studio Inc.
# Allowed Email Domain for Employee Logins (e.g. acme.com; leave blank to allow all email domains)
ALLOWED_DOMAIN=

# Production Domain & SSL (Used with Caddy)
DOMAIN=localhost
ACME_EMAIL=admin@example.com
