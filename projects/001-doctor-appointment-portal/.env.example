# =============================================================
# 🩺 001-DOCTOR-APPOINTMENT-PORTAL ENVIRONMENT VARIABLES
# =============================================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clinicdb

# Internal Database Connection URL (used by Next.js app inside container)
DATABASE_URL="postgresql://postgres:postgres@db:5432/clinicdb?schema=public"

# App Port & Environment
PORT=3000
NODE_ENV=production

# Initial Clinic Access PIN (Configurable via env, never shown in UI)
ADMIN_PIN=1234

# -------------------------------------------------------------
# PRODUCTION SSL & CUSTOM DOMAIN SETTINGS (Optional)
# -------------------------------------------------------------
# Uncomment and configure when going live with your custom domain:
# DOMAIN=clinic.yourdomain.com
# ACME_EMAIL=admin@yourdomain.com
