# =========================================================================
# 011-digital-qr-menu-board Configuration
# =========================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=menudb

# Database URL used by Prisma & Next.js
# For Docker Compose, the host is 'db':
DATABASE_URL="postgresql://postgres:postgres@db:5432/menudb?schema=public"

# For local development outside Docker (e.g. npm run dev):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/menudb?schema=public"

# Application Settings
PORT=3011
NODE_ENV=production

# Manager Studio Security PIN
ADMIN_PIN=1234

# =========================================================================
# Production Domain & SSL (When using Caddy reverse proxy)
# =========================================================================
# DOMAIN=menu.yourcafe.com
# ACME_EMAIL=admin@yourcafe.com
