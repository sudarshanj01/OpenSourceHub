generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RestaurantProfile {
  id                      String   @id @default(uuid())
  name                    String   @default("Spice Route Kitchen")
  tagline                 String   @default("Authentic Flavours, Modern Dining")
  description             String   @default("From fragrant biryanis to buttery naans and sizzler platters — crafted with freshly ground spices and age-old culinary tradition.")
  currencySymbol          String   @default("₹")
  currencyCode            String   @default("INR")
  cgstPercentage          Float    @default(2.5)
  sgstPercentage          Float    @default(2.5)
  serviceChargePercentage Float    @default(0.0)
  fssaiLicense            String   @default("10019011006543")
  gstNumber               String   @default("07AAAAA1234A1Z5")
  address                 String   @default("Shop 14-16, Inner Circle, Connaught Place, New Delhi")
  phone                   String   @default("+91 98765 43210")
  email                   String   @default("order@spiceroutekitchen.in")
  wifiSsid                String   @default("SpiceRoute_Guest")
  wifiPassword            String   @default("Namaste2026")
  openingHours            String   @default("Mon - Sun: 11:30 AM – 11:30 PM")
  tableCount              Int      @default(20)
  adminPin                String   @default("1234")
  upiId                   String   @default("spiceroute@upi")
  bannerUrl               String?
  logoUrl                 String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Category {
  id          String     @id @default(uuid())
  name        String
  nameHindi   String?
  description String?
  icon        String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  items       MenuItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([sortOrder])
}

model MenuItem {
  id              String   @id @default(uuid())
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  nameHindi       String?
  description     String
  price           Float
  halfPrice       Float?
  isAvailable     Boolean  @default(true)
  foodType        String   @default("veg") // "veg" | "nonveg" | "egg"
  isJainAvailable Boolean  @default(false)
  spiceLevel      Int      @default(1) // 0=mild, 1=medium-mild, 2=medium, 3=spicy, 4=extra-hot
  cuisineType     String   @default("north-indian")
  isChefSpecial   Boolean  @default(false)
  isBestseller    Boolean  @default(false)
  isTodaySpecial  Boolean  @default(false)
  isNewItem       Boolean  @default(false)
  calories        Int?
  prepTimeMinutes Int?
  servesCount     String?  // "Serves 1-2"
  badge           String?
  imageUrl        String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([categoryId])
  @@index([isAvailable])
  @@index([sortOrder])
  @@index([foodType])
}
